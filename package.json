{
  "name": "multi-place-setup-flamework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:game": "rbxtsc -p ./places/game/tsconfig.build.json",
    "build:lobby": "rbxtsc -p ./places/lobby/tsconfig.build.json",
    "build:all": "npm run build:game && npm run build:lobby",
    "watch:game": "rm -rf ./places/game/out && rbxtsc -w -p ./places/game/tsconfig.build.json",
    "watch:lobby": "rm -rf ./places/lobby/out && rbxtsc -w -p ./places/lobby/tsconfig.build.json",
    "serve:game": "rojo serve ./places/game --port 34873",
    "serve:lobby": "rojo serve ./places/lobby --port 34872",
    "serve:all": "npm run serve:lobby & npm run serve:game"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rbxts/compiler-types": "3.0.0-types.0",
    "@rbxts/types": "^1.0.888",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "^8",
    "eslint-config-prettier": "^9",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-roblox-ts": "^1.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.6.2",
    "rbxts-transformer-flamework": "^1.3.2",
    "roblox-ts": "^3.0.0",
    "typescript": "5.5.3"
  },
  "dependencies": {
    "@flamework/core": "^1.3.2",
    "@flamework/networking": "^1.3.2",
    "@rbxts/charm": "^0.10.0",
    "@rbxts/immut": "0.4.4-ts.0",
    "@rbxts/lapis": "^0.3.8",
    "@rbxts/services": "^1.6.0",
    "@rbxts/signal": "^1.1.1",
    "@rbxts/squash": "^3.0.0-ts.0",
    "@rbxts/t": "^3.2.1"
  }
}
